	column 'Customer Type' =
			
			IF(
			    customer_metrics[order_count] > 1,
			    "Repeat Customer",
			    "One-time Customer"
			)
		lineageTag: 0dc264fd-83c3-4b46-ad9a-de80e34550c2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition customer_metrics = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([Implementation="2.0"]),
				    #"mda-platform-2026_Database" = Source{[Name="mda-platform-2026",Kind="Database"]}[Data],
				    analytics_dev_Schema = #"mda-platform-2026_Database"{[Name="analytics_dev",Kind="Schema"]}[Data],
