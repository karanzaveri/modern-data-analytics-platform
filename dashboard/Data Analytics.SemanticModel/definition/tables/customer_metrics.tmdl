table customer_metrics
	lineageTag: b1c4d0ea-6ed7-4851-997a-e64c44ec425c

	measure 'Repeat Customer Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNT(customer_metrics[customer_unique_id]),
			        customer_metrics[order_count] > 1
			    ),
			    COUNT(customer_metrics[customer_unique_id])
			)
		formatString: 0.00%
		lineageTag: 9c039829-51fc-4bff-a746-494505b6704d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column customer_unique_id
		dataType: string
		lineageTag: a350065c-c80c-48d0-af88-ac2235517b3f
		summarizeBy: none
		sourceColumn: customer_unique_id

		annotation SummarizationSetBy = Automatic

	column first_order_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: dcc9c16e-830a-4590-9aa0-c54364ddd121
		summarizeBy: none
		sourceColumn: first_order_date

		variation Variation
			isDefault
			relationship: a0d6f1ba-be43-47fb-99d0-2f38f8315397
			defaultHierarchy: LocalDateTable_49fca1f4-aeb0-4932-a6f0-ac8ea831fd80.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column last_order_date
