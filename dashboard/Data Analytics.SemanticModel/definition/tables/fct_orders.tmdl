	column 'Delivery Status' =
			IF(
			    fct_orders[order_status] <> "delivered",
			    "Not Delivered",
			    IF(
			        ISBLANK(fct_orders[delivery_delay_days]),
			        "Unknown",
			        IF(
			            fct_orders[delivery_delay_days] > 0,
			            "Late",
			            "On Time"
			        )
			    )
			)
		lineageTag: afa841bc-283f-49df-b990-210b90538ccf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

