table fct_orders
	lineageTag: 90f6ba15-b1ba-420e-8029-368f9d8b894e

	measure 'Average Delivery Days' =
			CALCULATE(
			    AVERAGE(fct_orders[delivery_days]),
			    fct_orders[order_status] = "delivered",
			    NOT ISBLANK(fct_orders[delivery_days])
			)
		formatString: 0.00
		lineageTag: 94c98d47-fa4c-4467-9553-72817cdc67d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Delivery Rate' =
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(fct_orders),
			        fct_orders[order_status] = "delivered",
			        NOT ISBLANK(fct_orders[delivery_delay_days]),
			        fct_orders[delivery_delay_days] > 0
			    ),
			    CALCULATE(
			        COUNTROWS(fct_orders),
			        fct_orders[order_status] = "delivered",
			        NOT ISBLANK(fct_orders[delivery_delay_days])
			    )
			)
		formatString: 0.00%
		lineageTag: 981d770c-7bbc-4038-97d3-2b24dea2b70e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delivered Revenue' =
			CALCULATE(
			    SUM(fct_orders[total_payment_value]),
			    fct_orders[order_status] = "delivered"
			)
		formatString: #,0.00
		lineageTag: 38f982e8-c53e-4422-8b96-5a8f50f1f2a0

	measure 'Delivered Orders' =
			CALCULATE(
			    COUNTROWS(fct_orders),
			    fct_orders[order_status] = "delivered"
			)
		formatString: #,0
		lineageTag: b5c5049f-decd-4b2c-bd52-546626fa8e81

	measure 'Distinct Customers' = DISTINCTCOUNT(fct_orders[customer_unique_id])
		formatString: #,0
		lineageTag: 2fde60aa-6023-4bff-a8da-6b006de881f4

	measure 'Geography Delivered AOV' = DIVIDE([Delivered Revenue], [Delivered Orders])
		formatString: #,0.00
		lineageTag: e36e091a-d562-40b4-837d-701633b742fe

	measure 'Average Delay Days (Late Orders)' =
			CALCULATE(
			    AVERAGE(fct_orders[delivery_delay_days]),
			    fct_orders[order_status] = "delivered",
			    NOT ISBLANK(fct_orders[delivery_delay_days]),
			    fct_orders[delivery_delay_days] > 0
			)
		formatString: 0.00
		lineageTag: 71ac3b91-6a6f-452d-b88a-5d508a6cfa0f

