table ab_summary
	lineageTag: 010c0204-53bd-4311-abe6-8cbb2503cae1

	measure 'Total Participants' = SUM(ab_variants[users])
		formatString: #,0
		lineageTag: 03b85779-76c6-4e9a-a657-06b864099d2a

	measure 'Control Conversion' = SELECTEDVALUE(ab_summary[control_conversion_rate])
		formatString: 0.000%
		lineageTag: 9f62f082-41aa-4c17-a8ed-0dc7d2fec947

	measure 'Treatment Conversion' = SELECTEDVALUE(ab_summary[treatment_conversion_rate])
		formatString: 0.000%
		lineageTag: a1cd61de-a77f-4e37-a36d-28b110d294bf

	measure 'Absolute Uplift pp' = 100 * SELECTEDVALUE(ab_summary[conversion_difference])
		formatString: +0.000" pp";-0.000" pp";0.000" pp"
		lineageTag: 585b61a4-a583-4d08-9f3d-c99e81adbfc6

	measure 'Experiment P-value' = SELECTEDVALUE(ab_summary[p_value])
		formatString: 0.000000
		lineageTag: 4675f40c-0756-4a94-89b8-f89e60e00963

	measure 'Experiment Design Text' =
			"SYNTHETIC checkout redesign | Seed " & FORMAT(SELECTEDVALUE(ab_summary[random_seed]), "0") &
			UNICHAR(10) & FORMAT(SELECTEDVALUE(ab_summary[actual_sample_size_per_arm]), "#,0") & " users per arm | Fixed allocation | Alpha " & FORMAT(SELECTEDVALUE(ab_summary[alpha]), "0.00") &
			UNICHAR(10) & "Independent Bernoulli outcomes; fixed-horizon analysis"
		lineageTag: bb311d2d-a820-4e36-8a89-6a23839ca97c

	measure 'Inference Text' =
			"Treatment B minus Control A: " & FORMAT([Absolute Uplift pp], "+0.000;-0.000;0.000") & " pp" &
			UNICHAR(10) & FORMAT(SELECTEDVALUE(ab_summary[confidence_level]), "0%") & " CI lower: " & FORMAT(100 * SELECTEDVALUE(ab_summary[ci_lower]), "+0.000;-0.000;0.000") & " pp | Upper: " & FORMAT(100 * SELECTEDVALUE(ab_summary[ci_upper]), "+0.000;-0.000;0.000") & " pp" &
			UNICHAR(10) & "Relative uplift: " & FORMAT(SELECTEDVALUE(ab_summary[relative_uplift]), "+0.000%;-0.000%;0.000%") &
			UNICHAR(10) & "p = " & FORMAT([Experiment P-value], "0.000000") & " | " & IF(SELECTEDVALUE(ab_summary[statistically_significant]), "Statistically significant", "Not statistically significant") &
			UNICHAR(10) & SELECTEDVALUE(ab_summary[statistical_test_method]) &
			UNICHAR(10) & "CI method: " & SELECTEDVALUE(ab_summary[confidence_interval_method]) &
			UNICHAR(10) & "Confidence describes interval coverage, not a probability of treatment success."
		lineageTag: 6520a8ad-d805-49cb-b6d1-4c1ac59b2193

	measure 'Diagnostics Text' =
			"Planned users/arm: " & FORMAT(SELECTEDVALUE(ab_summary[planned_sample_size_per_arm]), "#,0") & " | MDE: " & FORMAT(100 * SELECTEDVALUE(ab_summary[planned_mde]), "0.0") & " pp" &
			UNICHAR(10) & "Target / theoretical power: " & FORMAT(SELECTEDVALUE(ab_summary[target_power]), "0.0%") & " / " & FORMAT(SELECTEDVALUE(ab_summary[theoretical_power]), "0.0%") &
			UNICHAR(10) & "Empirical power: " & FORMAT(SELECTEDVALUE(ab_summary[empirical_power]), "0.0%") & " (" & FORMAT(SELECTEDVALUE(ab_summary[power_simulation_trials]), "#,0") & " trials)" &
			UNICHAR(10) & "Null false positives: " & FORMAT(SELECTEDVALUE(ab_summary[empirical_false_positive_rate]), "0.0%") & " (" & FORMAT(SELECTEDVALUE(ab_summary[null_simulation_trials]), "#,0") & " trials)" &
			UNICHAR(10) & "SRM p = " & FORMAT(SELECTEDVALUE(ab_summary[srm_p_value]), "0.000") & " | Threshold " & FORMAT(SELECTEDVALUE(ab_summary[srm_threshold]), "0.000") &
			UNICHAR(10) & "Balance is fixed by construction, not evidence of assignment quality."
		lineageTag: 3151e4fe-45e1-4a3c-904c-246070878c10

	measure 'Quarterly Impact Text' =
			"HYPOTHETICAL: " & FORMAT(SELECTEDVALUE(ab_summary[projected_eligible_users]), "#,0") & " users; EUR " & FORMAT(SELECTEDVALUE(ab_summary[contribution_profit_per_conversion]), "0") & " profit/conversion" &
			UNICHAR(10) & "Implementation / ongoing: EUR " & FORMAT(SELECTEDVALUE(ab_summary[implementation_cost]), "#,0") & " / " & FORMAT(SELECTEDVALUE(ab_summary[ongoing_costs]), "#,0") &
			UNICHAR(10) & "Incremental conversions: " & FORMAT(SELECTEDVALUE(ab_summary[expected_incremental_conversions]), "#,0.0") &
			UNICHAR(10) & "Net benefit: EUR " & FORMAT(SELECTEDVALUE(ab_summary[estimated_net_financial_benefit]), "#,0.00;-#,0.00") &
			UNICHAR(10) & "Lower / upper: EUR " & FORMAT(SELECTEDVALUE(ab_summary[lower_net_financial_scenario]), "#,0;-#,0") & " / " & FORMAT(SELECTEDVALUE(ab_summary[upper_net_financial_scenario]), "#,0;-#,0") &
			UNICHAR(10) & "Break-even uplift: " & FORMAT(100 * SELECTEDVALUE(ab_summary[break_even_uplift]), "0.000") & " pp" &
			UNICHAR(10) & "Fixed traffic and economics; scenarios are not forecasts."
		lineageTag: a84fc266-f210-45ee-bb91-11a30b33075b

	measure 'Recommendation Text' =
			"No full rollout recommended: " &
			IF(SELECTEDVALUE(ab_summary[estimated_net_financial_benefit]) < 0, "negative financial projection; ", "financial assumptions require validation; ") &
			IF(COUNTROWS(FILTER(ab_guardrails, ab_guardrails[availability] = "missing")) > 0, "guardrails not measured; ", "guardrails require review; ") &
			IF(SELECTEDVALUE(ab_summary[is_synthetic]), "synthetic experiment. Real validity and instrumentation remain unverified.", "validity and instrumentation require review.")
		lineageTag: f09e8a22-02df-4e39-b529-94b71eb11560

