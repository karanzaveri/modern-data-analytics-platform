ed_net_financial_benefit", type number}, {"lower_net_financial_scenario", type number}, {"upper_net_financial_scenario", type number}, {"break_even_uplift", type number}, {"economically_attractive_under_assumptions", type logical}, {"rollout_readiness", type text}, {"limitations", type text}, {"numpy_version", type text}, {"pandas_version", type text}, {"statsmodels_version", type text}, {"scipy_version", type text}}, "en-US")
