table fct_order_items
	lineageTag: ff938224-59b5-4740-bba5-5443b5ceae2b

	measure 'Delivered Merchandise Value' =
			CALCULATE(
			    SUM(fct_order_items[price]),
			    fct_order_items[order_status] = "delivered"
			)
		formatString: #,0.00
		lineageTag: 5a4f8546-b672-4fa8-a7b7-70274d850ff1

	measure 'Delivered Freight Value' =
			CALCULATE(
			    SUM(fct_order_items[freight_value]),
			    fct_order_items[order_status] = "delivered"
			)
		formatString: #,0.00
		lineageTag: f03ede72-f460-46dd-8e90-ad9b92396dcf

	measure 'Delivered Item Total Value' =
			CALCULATE(
			    SUM(fct_order_items[item_total_value]),
			    fct_order_items[order_status] = "delivered"
			)
		formatString: #,0.00
		lineageTag: 857cf9fa-eb04-4cd5-9c3c-a2af3ace9c6b

	measure 'Delivered Item Count' =
			CALCULATE(
			    COUNTROWS(fct_order_items),
			    fct_order_items[order_status] = "delivered"
			)
		formatString: #,0
		lineageTag: 5bf7d80f-1d76-469d-b948-c323c039978b

	measure 'Delivered Item Orders' =
			CALCULATE(
			    DISTINCTCOUNT(fct_order_items[order_id]),
			    fct_order_items[order_status] = "delivered"
			)
		formatString: #,0
		lineageTag: 10be028d-e5d3-4731-baa8-27dd97d9f910

	measure 'Delivered Item Customers' =
			CALCULATE(
			    DISTINCTCOUNT(fct_order_items[customer_unique_id]),
			    fct_order_items[order_status] = "delivered"
			)
		formatString: #,0
		lineageTag: 90c7b6e5-534a-464e-a692-657251797b80

	measure 'Active Delivered Products' =
			CALCULATE(
			    DISTINCTCOUNT(fct_order_items[product_id]),
			    fct_order_items[order_status] = "delivered"
			)
		formatString: #,0
		lineageTag: 0b280ef2-3584-4718-831a-33fee4df8f49

	measure 'Active Delivered Sellers' =
			CALCULATE(
			    DISTINCTCOUNT(fct_order_items[seller_id]),
			    fct_order_items[order_status] = "delivered"
			)
		formatString: #,0
		lineageTag: 894325f1-c271-430a-b3c4-ac9487b5c7a4

	measure 'Average Delivered Item Price' = DIVIDE([Delivered Merchandise Value], [Delivered Item Count])
		formatString: #,0.00
		lineageTag: fd3da425-5ff5-4629-b81c-6d1e34ccb0f3

	measure 'Delivered Freight Share' = DIVIDE([Delivered Freight Value], [Delivered Item Total Value])
		formatString: 0.00%
		lineageTag: ec86ce49-6b2d-4d93-bf69-828bfdb3ec9e

